@model WebWayCMS.TestHost.Pages.ZoneShowcasePageConfiguration
@{
    var activeView = ViewData["ActiveView"] as string ?? "TwoColumn";
}
<div data-testid="showcase-view-two-column">
    <h1>@(string.IsNullOrWhiteSpace(Model.Heading) ? "Zone Showcase" : Model.Heading)</h1>
    @if (Model.ShowDiagnostics)
    {
        @await Html.PartialAsync("_PageDiagnostics", activeView)
    }

    <div data-testid="zone-page-header">
        @await Component.InvokeAsync("ContentZone", new { zoneName = "PageHeader" })
    </div>

    <div class="row">
        <div class="col-md-8" data-testid="zone-page-main">
            @await Component.InvokeAsync("ContentZone", new { zoneName = "PageMain" })
        </div>
        <div class="col-md-4" data-testid="zone-page-aside">
            @await Component.InvokeAsync("ContentZone", new { zoneName = "PageAside" })
        </div>
    </div>

    <div data-testid="zone-page-footer">
        @await Component.InvokeAsync("ContentZone", new { zoneName = "PageFooter" })
    </div>

    <div data-testid="zone-showcase-global">
        @await Component.InvokeAsync("ContentZone", new { zoneName = "ShowcaseGlobal", IsGlobal = true })
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <p class="text-muted">@Model.Note</p>
    }
</div>
