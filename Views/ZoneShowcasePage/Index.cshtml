@model WebWayCMS.TestHost.Pages.ZoneShowcasePageConfiguration
@{
    var activeView = ViewData["ActiveView"] as string ?? "Index";
}
<div data-testid="showcase-view-index">
    <h1>@(string.IsNullOrWhiteSpace(Model.Heading) ? "Zone Showcase" : Model.Heading)</h1>
    @if (Model.ShowDiagnostics)
    {
        @await Html.PartialAsync("_PageDiagnostics", activeView)
    }

    <div class="row">
        <div class="col-12" data-testid="zone-page-main">
            @await Component.InvokeAsync("ContentZone", new { zoneName = "PageMain" })
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <p class="text-muted">@Model.Note</p>
    }
</div>
