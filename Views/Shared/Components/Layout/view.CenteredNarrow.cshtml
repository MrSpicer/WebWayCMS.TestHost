@*
    Centered Narrow Layout
        ┌──────────────┐
        │   Main (8)   │
        │  (centered)  │
        └──────────────┘

    Use case: Blog posts, articles, forms, focused content
    Mobile: Full width automatically
*@

<div class="container py-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            @await Component.InvokeAsync("ContentZone", new { zoneName = "Main" })
        </div>
    </div>
</div>
