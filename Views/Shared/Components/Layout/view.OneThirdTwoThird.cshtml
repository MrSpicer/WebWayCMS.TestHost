@*
    One-Third Two-Thirds Layout
    ┌───────┬─────────────────┐
    │Side(4)│     Main (8)    │
    └───────┴─────────────────┘

    Use case: Narrow sidebar navigation with wide content area
    Mobile: Columns stack automatically
*@

<div class="container py-5">
    <div class="row">
        <div class="col-md-4">
            @await Component.InvokeAsync("ContentZone", new { zoneName = "Sidebar" })
        </div>
        <div class="col-md-8">
            @await Component.InvokeAsync("ContentZone", new { zoneName = "Main" })
        </div>
    </div>
</div>
