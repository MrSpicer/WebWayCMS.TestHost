@*
    Two Column Sidebar Layout
    ┌──────────────┬─────────┐
    │   Main (8)   │ Side(4) │
    └──────────────┴─────────┘

    Use case: Blog posts with sidebar, documentation with navigation
    Mobile: Columns stack automatically
*@

<div class="container py-5">
    <div class="row">
        <div class="col-md-8">
            @await Component.InvokeAsync("ContentZone", new { zoneName = "Main" })
        </div>
        <div class="col-md-4">
            @await Component.InvokeAsync("ContentZone", new { zoneName = "Sidebar" })
        </div>
    </div>
</div>
