@*
    Asymmetric Right-Heavy Layout
    ┌─────────┬──────────────┐
    │ Side(4) │   Main (8)   │
    └─────────┴──────────────┘

    Use case: Navigation-first layouts, filters on left
    Mobile: Columns stack automatically (sidebar appears first on mobile)
*@

<div class="container py-5">
    <div class="row">
        <div class="col-md-4">
            @await Component.InvokeAsync("ContentZone", new { zoneName = "Sidebar" })
        </div>
        <div class="col-md-8">
            @await Component.InvokeAsync("ContentZone", new { zoneName = "Main" })
        </div>
    </div>
</div>
